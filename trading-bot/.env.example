# network (mainnet, testnet)
NETWORK=mainnet

# gRPC fullnode URL (optional; public defaults used if unset). Use https://host:443
SUI_MAINNET_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_TESTNET_RPC_URL=https://fullnode.testnet.sui.io:443

# Sui wallet private key in Bech32 format (e.g. suiprivkey1...)
# Required. Never commit this file with a real key.
PRIVATE_KEY=