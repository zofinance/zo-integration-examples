{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "outDir": "dist",
        "sourceMap": true,
        "declaration": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
